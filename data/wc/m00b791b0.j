{"ok":true,"module":"poollogic/ph","docs":{"poollogic/ph/ph_auto_mode":{"type":"Bool","label_t":"cfgdocs.poollogic.ph.ph_auto_mode.label","help_t":"cfgdocs.poollogic.ph.ph_auto_mode.help","label":"Mode auto pH","label_i18n":"cfgdocs.poollogic.ph.ph_auto_mode.label","help":"Active la régulation automatique du pH.","help_i18n":"cfgdocs.poollogic.ph.ph_auto_mode.help"},"poollogic/ph/ph_dose_plus":{"type":"Bool","label_t":"cfgdocs.poollogic.ph.ph_dose_plus.label","help_t":"cfgdocs.poollogic.ph.ph_dose_plus.help","label":"Injection pH+","label_i18n":"cfgdocs.poollogic.ph.ph_dose_plus.label","help":"Si activé, la pompe pH injecte du pH+ (sinon pH-).","help_i18n":"cfgdocs.poollogic.ph.ph_dose_plus.help"},"poollogic/ph/ph_kd":{"type":"Float","label_t":"cfgdocs.poollogic.ph.ph_kd.label","help_t":"cfgdocs.poollogic.ph.ph_kd.help","label":"pH Kd","label_i18n":"cfgdocs.poollogic.ph.ph_kd.label","help":"Gain dérivé du régulateur pH.","help_i18n":"cfgdocs.poollogic.ph.ph_kd.help"},"poollogic/ph/ph_ki":{"type":"Float","label_t":"cfgdocs.poollogic.ph.ph_ki.label","help_t":"cfgdocs.poollogic.ph.ph_ki.help","label":"pH Ki","label_i18n":"cfgdocs.poollogic.ph.ph_ki.label","help":"Gain intégral du régulateur pH.","help_i18n":"cfgdocs.poollogic.ph.ph_ki.help"},"poollogic/ph/ph_kp":{"type":"Float","label_t":"cfgdocs.poollogic.ph.ph_kp.label","help_t":"cfgdocs.poollogic.ph.ph_kp.help","label":"pH Kp","label_i18n":"cfgdocs.poollogic.ph.ph_kp.label","help":"Gain proportionnel du régulateur pH.","help_i18n":"cfgdocs.poollogic.ph.ph_kp.help"},"poollogic/ph/ph_setpoint":{"type":"Float","label_t":"cfgdocs.poollogic.ph.ph_setpoint.label","help_t":"cfgdocs.poollogic.ph.ph_setpoint.help","label":"Consigne pH","label_i18n":"cfgdocs.poollogic.ph.ph_setpoint.label","help":"Valeur cible de pH pour la régulation.","help_i18n":"cfgdocs.poollogic.ph.ph_setpoint.help"},"poollogic/ph/ph_window_ms":{"type":"Int32","label_t":"cfgdocs.poollogic.ph.ph_window_ms.label","help_t":"cfgdocs.poollogic.ph.ph_window_ms