{"ok":true,"module":"poollogic/filtration","docs":{"poollogic/filtration/filtr_start_clc":{"enum_set":"hours_of_day"},"poollogic/filtration/filtr_start_min":{"enum_set":"hours_of_day"},"poollogic/filtration/filtr_stop_clc":{"enum_set":"hours_of_day"},"poollogic/filtration/filtr_stop_max":{"enum_set":"hours_of_day"},"poollogic/filtration/wat_temp_lo_th":{"type":"Float","label_t":"cfgdocs.poollogic.filtration.wat_temp_lo_th.label","help_t":"cfgdocs.poollogic.filtration.wat_temp_lo_th.help","unit":"C","label":"Seuil eau basse (C)","label_i18n":"cfgdocs.poollogic.filtration.wat_temp_lo_th.label","help":"Seuil bas de température d'eau pour la logique de filtration.","help_i18n":"cfgdocs.poollogic.filtration.wat_temp_lo_th.help"},"poollogic/filtration/wat_temp_setpt":{"type":"Float","label_t":"cfgdocs.poollogic.filtration.wat_temp_setpt.label","help_t":"cfgdocs.poollogic.filtration.wat_temp_setpt.help","unit":"C","label":"Consigne eau (C)","label_i18n":"cfgdocs.poollogic.filtration.wat_temp_setpt.label","help":"Consigne de température d'eau pour le calcul de filtration.","help_i18n":"cfgdocs.poollogic.filtration.wat_temp_setpt.help"},"poollogic/filtration/winter_duration_min":{"type":"UInt16","label_t":"cfgdocs.poollogic.filtration.winter_duration_min.label","help_t":"cfgdocs.poollogic.filtration.winter_duration_min.help","unit":"min","label":"Durée filtration hivernage (min)","label_i18n":"cfgdocs.poollogic.filtration.winter_duration_min.label","help":"Durée de marche par cycle : 15 min par défaut, minimum 1 min, limitée à la période. Le hors gel peut prolonger la filtration.","help_i18n":"cfgdocs.poollogic.filtration.winter_duration_min.help"},"poollogic/filtration/winter_interval_h":{"type":"UInt8","label_t":"cfgdocs.poollogic.filtration.winter_interval_h.label","help_t":"cfgdocs.poollogic.filtration.winter_interval_h.help","unit":"h","label":"Intervalle hivernage (h)","label_i18n":"cfgdocs.poollogic.filtration.winter_interval_h.label","help":"Intervalle entre deux démarrages : de 1 à 24 h, 1 h par défaut. Un cycle démarre dès l’activation du mode hiver en automatique.","help_i18n":"cfgdocs.poollogic.filtration.winter_interval_h.help"}},"meta":{}}