{"ok":true,"module":"poollogic/o2","docs":{"poollogic/o2/dose_ml_10m3_week":{"type":"Float","label_t":"cfgdocs.poollogic.o2.dose_ml_10m3_week.label","help_t":"cfgdocs.poollogic.o2.dose_ml_10m3_week.help","unit":"ml","label":"Dose O2 hebdo / 10 m3","label_i18n":"cfgdocs.poollogic.o2.dose_ml_10m3_week.label","help":"Dose hebdomadaire d'oxygène actif liquide pour 10 m3.","help_i18n":"cfgdocs.poollogic.o2.dose_ml_10m3_week.help"},"poollogic/o2/last_dose_day":{"type":"UInt16","label_t":"cfgdocs.poollogic.o2.last_dose_day.label","help_t":"cfgdocs.poollogic.o2.last_dose_day.help","label":"Dernier jour dose O2","label_i18n":"cfgdocs.poollogic.o2.last_dose_day.label","help":"Jour interne de la dernière injection O2 effectuée.","help_i18n":"cfgdocs.poollogic.o2.last_dose_day.help"},"poollogic/o2/load_factor":{"type":"Float","label_t":"cfgdocs.poollogic.o2.load_factor.label","help_t":"cfgdocs.poollogic.o2.load_factor.help","label":"Facteur charge O2","label_i18n":"cfgdocs.poollogic.o2.load_factor.label","help":"Facteur manuel appliqué au dosage O2 calculé.","help_i18n":"cfgdocs.poollogic.o2.load_factor.help"},"poollogic/o2/main_hour":{"type":"UInt8","label_t":"cfgdocs.poollogic.o2.main_hour.label","help_t":"cfgdocs.poollogic.o2.main_hour.help","enum_set":"hours_of_day","label":"Heure dosage O2","label_i18n":"cfgdocs.poollogic.o2.main_hour.label","help":"Heure principale prévue pour le dosage O2.","help_i18n":"cfgdocs.poollogic.o2.main_hour.help"},"poollogic/o2/min_filter_run_min":{"type":"UInt8","label_t":"cfgdocs.poollogic.o2.min_filter_run_min.label","help_t":"cfgdocs.poollogic.o2.min_filter_run_min.help","unit":"min","label":"Filtration mini O2","label_i18n":"cfgdocs.poollogic.o2.min_filter_run_min.label","help":"Durée minimale de filtration avant autorisation du dosage O2.","help_i18n":"cfgdocs.poollogic.o2.min_filter_run_min.help"},"poollogic/o2/pending_ml":{"type":"Float","label_t":"cfgdocs.poollogic.o2.pending_ml.label","help_t":"cfgdocs.poollogic.o2.pending_ml.help","u