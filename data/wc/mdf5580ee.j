{"ok":true,"module":"ethernet","docs":{"ethernet/enabled":{"type":"Bool","label_t":"cfgdocs.ethernet.enabled.label","help_t":"cfgdocs.ethernet.enabled.help","label":"Ethernet activé","label_i18n":"cfgdocs.ethernet.enabled.label","help":"Active ou désactive l'interface Ethernet W5500. Quand Ethernet est actif, il est prioritaire; le WiFi station puis le portail AP servent de fallback si Ethernet n'obtient pas d'IP.","help_i18n":"cfgdocs.ethernet.enabled.help"}},"meta":{}}