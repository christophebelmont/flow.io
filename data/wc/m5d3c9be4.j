{"ok":true,"module":"time","docs":{"time/enabled":{"type":"Bool","label_t":"cfgdocs.time.enabled.label","help_t":"cfgdocs.time.enabled.help","label":"Synchronisation horaire active","label_i18n":"cfgdocs.time.enabled.label","help":"Active ou désactive la synchronisation horaire NTP.","help_i18n":"cfgdocs.time.enabled.help"},"time/manual_time":{"type":"CharArray","label_t":"cfgdocs.time.manual_time.label","help_t":"cfgdocs.time.manual_time.help","label":"Heure manuelle Nextion","label_i18n":"cfgdocs.time.manual_time.label","help":"Heure manuelle a ecrire dans le RTC Nextion au format YYYY-MM-DD HH:MM:SS.","help_i18n":"cfgdocs.time.manual_time.help"},"time/server1":{"type":"CharArray","label_t":"cfgdocs.time.server1.label","help_t":"cfgdocs.time.server1.help","label":"Serveur NTP","label_i18n":"cfgdocs.time.server1.label","help":"Serveur utilisé pour la synchronisation de l'heure.","help_i18n":"cfgdocs.time.server1.help"},"time/server2":{"type":"CharArray","label_t":"cfgdocs.time.server2.label","help_t":"cfgdocs.time.server2.help","label":"Serveur NTP secondaire","label_i18n":"cfgdocs.time.server2.label","help":"Serveur NTP de secours utilisé si le principal échoue.","help_i18n":"cfgdocs.time.server2.help"},"time/tz":{"type":"CharArray","label_t":"cfgdocs.time.tz.label","help_t":"cfgdocs.time.tz.help","label":"Fuseau horaire","label_i18n":"cfgdocs.time.tz.label","help":"Fuseau horaire utilisé pour les horaires et l'affichage de l'heure.","help_i18n":"cfgdocs.time.tz.help","enum_set":"timezones_world"},"time/week_start_mon":{"type":"Bool","label_t":"cfgdocs.time.week_start_mon.label","help_t":"cfgdocs.time.week_start_mon.help","label":"Semaine commence lundi","label_i18n":"cfgdocs.time.week_start_mon.label","help":"Définit le premier jour de semaine pour les plannings.","help_i18n":"cfgdocs.time.week_start_mon.help"}},"meta":{}}